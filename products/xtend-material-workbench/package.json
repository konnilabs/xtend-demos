{
  "name": "@ccslabs/xtend-material-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "XTM-12 catfooding product for XTend Material evidence, recipes and lessons.",
  "scripts": {
    "plan": "xt maraca plan --config maraca.config.json --json",
    "build": "xt maraca build --config maraca.config.json --json",
    "tune": "xt maraca tune src/app.rmt --config maraca.tuned.config.json --out dist --write --json",
    "test": "node --test test/material-workbench.test.cjs"
  },
  "dependencies": {
    "@ccslabs/xtend": "0.9.0",
    "@ccslabs/xtend-maraca": "0.9.0",
    "@xtend-material/core": "0.1.0",
    "@ccslabs/xtend-compiler": "0.9.0",
    "@ccslabs/xtend-rmt": "0.9.0",
    "@ccslabs/xtend-cli": "0.9.0",
    "@ccslabs/xtend-fabric": "0.9.0",
    "@xtend-material/maraca-tailwind": "0.1.0",
    "@ccslabs/xtend-mcp": "0.1.0",
    "@ccslabs/xtend-xsurface-shard": "0.9.0"
  },
  "devDependencies": {
    "tailwindcss": "4.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "xtend": {
    "schema": "xtend.material.catfooding-product.v1",
    "ticket": "XTM-12",
    "runtime": "maraca",
    "designKit": "material",
    "scaffoldLineage": "xtend.scaffold.app-preset.material.v1",
    "browserTailwindRuntime": false,
    "monkeypatchingAllowed": false
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konnilabs/xtend-demos.git",
    "directory": "products/xtend-material-workbench"
  }
}
