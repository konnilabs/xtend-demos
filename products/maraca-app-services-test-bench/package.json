{
  "name": "maraca-app-services-test-bench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "Generated XTend Material Maraca application.",
  "scripts": {
    "plan": "xt maraca plan --config maraca.config.json --json",
    "build": "xt maraca build --config maraca.config.json --json",
    "serve": "npm start",
    "start": "npm run build && node server/index.mjs",
    "tune": "xt maraca tune src/app.rmt --config maraca.config.json --out dist --write --json",
    "test": "node --test test/material-app.smoke.test.cjs",
    "test:catfood": "npm run build && node --test"
  },
  "dependencies": {
    "@ccslabs/xtend": "0.9.0",
    "@ccslabs/xtend-maraca": "0.9.0",
    "@xtend-material/core": "0.1.0",
    "@ccslabs/xtend-compiler": "0.9.0",
    "@ccslabs/xtend-rmt": "0.9.0",
    "@ccslabs/xtend-cli": "0.9.0",
    "@ccslabs/xtend-fabric": "0.9.0",
    "@xtend-material/maraca-tailwind": "0.1.0",
    "@ccslabs/xtend-mcp": "0.1.0",
    "@ccslabs/xtend-xsurface-shard": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tailwindcss": "4.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konnilabs/xtend-demos.git",
    "directory": "products/maraca-app-services-test-bench"
  }
}
