{
  "schema": "xtend.product-owner-transfer.v1",
  "repository": "konnilabs/xtend-demos",
  "suiteIds": [
    "erp-resumability-catfood",
    "maraca-app-services-test-bench",
    "xtend-llm-app-services-catfood",
    "xtend-material-catfooding",
    "xtend-shop-browser",
    "xtend-shop-contracts",
    "xtend-shop-php"
  ],
  "suites": [
    {
      "id": "xtend-llm-app-services-catfood",
      "label": "XTend LLM AppServices Catfood",
      "description": "Builds the XTend LLM production product through Maraca and validates its AppServices source, service graph, bundle, types and budget evidence.",
      "defaultIncluded": true,
      "handler": "xtend-llm-app-services-catfood",
      "implementations": [
        {
          "path": "tests/products/xtend_llm_app_services_catfood_suite.js",
          "function": "runXtendLlmAppServicesCatfoodSuite",
          "arguments": [
            "{ rootDir }"
          ]
        }
      ],
      "resources": [
        "repository",
        "browser"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "maraca-app-services-test-bench",
      "label": "Maraca App Services Test Bench",
      "description": "Builds and exercises the strict CLI-generated Node/SQLite AppServices catfood product.",
      "defaultIncluded": true,
      "handler": "maraca-app-services-test-bench",
      "implementations": [
        {
          "path": "tests/products/maraca_app_services_test_bench_suite.js",
          "function": "runMaracaAppServicesTestBenchSuite",
          "arguments": [
            "{ rootDir }"
          ]
        }
      ],
      "resources": [
        "repository",
        "browser"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "xtend-material-catfooding",
      "label": "XTM-12 XTend Material Catfooding Workbench",
      "description": "Builds and tunes the RMT-first Workbench, captures product browser evidence and gates lessons, Dev Surface, Trusted DOM and anti-monkeypatching ownership.",
      "defaultIncluded": true,
      "handler": "xtend-material-catfooding",
      "implementations": [
        {
          "path": "tests/products/xtend_material_catfooding_suite.js",
          "function": "runXtendMaterialCatfoodingSuite",
          "arguments": [
            "{ rootDir }"
          ]
        }
      ],
      "resources": [
        "repository",
        "browser"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "erp-resumability-catfood",
      "label": "RMT ERP Resumability Catfooding",
      "description": "Builds and tunes the tracked ERP product, then gates signed resume, exact node adoption, intent replay, fallback and the eight-XTension matrix in Chromium.",
      "defaultIncluded": true,
      "handler": "erp-resumability-catfood",
      "implementations": [
        {
          "path": "tests/products/erp_resumability_catfooding_suite.js",
          "function": "runErpResumabilityCatfoodingSuite",
          "arguments": [
            "{ rootDir }"
          ]
        }
      ],
      "resources": [
        "repository",
        "browser"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "xtend-shop-contracts",
      "label": "XTend.store compiler and browser contracts",
      "description": "XTend.store compiler and browser contracts",
      "defaultIncluded": false,
      "handler": "xtend-shop-contracts",
      "implementations": [
        {
          "path": "tests/products/xtend_shop_suite.js",
          "function": "runXtendShopSuite",
          "arguments": [
            "{ rootDir, group: \"contracts\" }"
          ]
        }
      ],
      "resources": [
        "repository"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "xtend-shop-php",
      "label": "XTend.store PHP parity and domain",
      "description": "XTend.store PHP parity and domain",
      "defaultIncluded": false,
      "handler": "xtend-shop-php",
      "implementations": [
        {
          "path": "tests/products/xtend_shop_suite.js",
          "function": "runXtendShopSuite",
          "arguments": [
            "{ rootDir, group: \"php\" }"
          ]
        }
      ],
      "resources": [
        "repository"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "xtend-shop-browser",
      "label": "XTend.store isolated guest checkout",
      "description": "XTend.store isolated guest checkout",
      "defaultIncluded": false,
      "handler": "xtend-shop-browser",
      "implementations": [
        {
          "path": "tests/products/xtend_shop_suite.js",
          "function": "runXtendShopSuite",
          "arguments": [
            "{ rootDir, group: \"browser\" }"
          ]
        }
      ],
      "resources": [
        "repository",
        "browser"
      ],
      "timeoutMs": 300000
    }
  ],
